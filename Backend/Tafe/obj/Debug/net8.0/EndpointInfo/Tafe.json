  "components": {
    "schemas": {
      "AppUserLoginDTO": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "rememmberMe": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AppUserRegisterDTO": {
        "required": [
          "firstName",
          "userName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "userName": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9]+$",
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "password": {
            "type": "string",
            "format": "password",
            "nullable": true
          },
          "confirmPassword": {
            "type": "string",
            "format": "password",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EmployeeCreateDTO": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AppUserRegisterDTO"
          },
          "salary": {
            "type": "number",
            "format": "double"
          },
          "hireDate": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "EmployeeProfileUpdateDTO": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "nullable": true
          },
          "salary": {
            "type": "number",
            "format": "double"
          },
          "hireDate": {
            "type": "string",
            "format": "date"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
